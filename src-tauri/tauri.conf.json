{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "3D Viewer",
  "version": "0.0.1",
  "identifier": "com.viewer3d.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "title": "3D Viewer", "width": 1200, "height": 800, "minWidth": 800, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
